# All settings are optional; CLI flags override them. Prefix: LOGPIPE_
LOGPIPE_DB_PATH=./logpipe.duckdb
LOGPIPE_CHECKPOINT_PATH=./logpipe.checkpoint.json
LOGPIPE_BATCH_SIZE=5000
# Anomaly detection
LOGPIPE_ANOMALY_WINDOW_MINUTES=30
LOGPIPE_ANOMALY_Z_THRESHOLD=3.0
LOGPIPE_ANOMALY_MIN_POINTS=10
# Retention (logpipe compact): raw rows older than KEEP_RAW are rolled up per hour,
# hourly rollups older than KEEP_HOURLY are deleted; leave KEEP_HOURLY empty to keep them
LOGPIPE_KEEP_RAW=7d
LOGPIPE_KEEP_HOURLY=
# Optional stats API (pip install ".[api]")
LOGPIPE_API_HOST=0.0.0.0
LOGPIPE_API_PORT=8080

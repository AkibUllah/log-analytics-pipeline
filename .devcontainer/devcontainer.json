{
  "name": "log-analytics-pipeline",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -e \".[dev]\"",
  "postStartCommand": "bash .devcontainer/start-demo.sh",
  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": {
      "label": "HTML report",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Stats API (/docs)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
